---
import Layout from '../layouts/Layout.astro';
import Recorrido from '../components/Recorrido.astro';
import Tagline from '../components/Tagline.astro';
import Remodelacion from '../components/Remodelacion.astro';
import Tesis from '../components/Tesis.astro';
import Diseno4 from '../components/Diseno4.astro';
import Planos from '../components/Planos.astro';
import SobreMi from '../components/SobreMi.astro';
import Contacto from '../components/Contacto.astro';
import Icon from '../components/Icon.astro';
import { photo } from '../data/site';

const indice = [
  { href: '#remodelacion', label: 'Remodelación de cocina', img: photo('/photos/cocina_nuevo_3.webp', '') },
  { href: '#tesis', label: 'Tesis: Centro de Cultivos', img: photo('/photos/tesis_4.webp', '') },
  { href: '#diseno-4', label: 'Diseño 4: terrazas', img: photo('/photos/extras/diseno4_extra_1.webp', '') },
  { href: '#vivienda', label: 'Vivienda: planos', img: photo('/photos/planos/fachada.webp', ''), contain: true },
];
---

<Layout>
  <Recorrido />
  <Tagline />

  <section id="proyectos" aria-labelledby="proyectos-titulo">
    <div class="mx-auto max-w-6xl px-4 pt-16 md:px-8">
      <p class="eyebrow">Proyectos</p>
      <h2 id="proyectos-titulo" class="mt-3 text-3xl font-bold tracking-tight md:text-5xl">Cuatro trabajos, cuatro escalas</h2>
      <ul class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {
          indice.map((p) => (
            <li class="reveal">
              <a
                href={p.href}
                class="group block rounded-2xl border border-line bg-surface p-2 transition-transform duration-700 ease-fluid hover:-translate-y-1 active:scale-[0.98]"
              >
                <img
                  src={p.img.src}
                  alt=""
                  width={p.img.width}
                  height={p.img.height}
                  loading="lazy"
                  decoding="async"
                  class:list={["aspect-[4/3] w-full rounded-lg bg-white", p.contain ? "object-contain p-2" : "object-cover"]}
                />
                <span class="flex items-center justify-between gap-2 px-2 pt-3 pb-1 text-sm font-semibold">
                  {p.label}
                  <Icon
                    name="arrow-down"
                    class="size-4 shrink-0 text-muted transition-transform duration-700 ease-fluid group-hover:translate-y-0.5"
                  />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <Remodelacion />
    <Tesis />
    <Diseno4 />
    <Planos />
  </section>

  <SobreMi />
  <Contacto />
</Layout>
