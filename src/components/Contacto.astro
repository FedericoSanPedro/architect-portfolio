---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section id="contacto" class="px-4 py-24 md:px-8">
  <div class="reveal mx-auto max-w-6xl rounded-2xl bg-accent p-8 text-on-accent md:p-16">
    <p class="text-xs font-bold tracking-[0.16em] text-on-accent/70 uppercase">Contacto</p>
    <h2 class="mt-3 max-w-[680px] text-3xl font-bold tracking-tight md:text-5xl">Contame tu proyecto y lo pensamos juntos</h2>
    <p class="mt-4 max-w-[680px] text-base text-on-accent/80 md:text-lg">
      Una remodelación, una casa nueva, planos para presentar o renders para decidir. Escribime y te respondo a la brevedad.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener"
        class="btn justify-center bg-on-accent text-ink hover:bg-white"
      >
        <Icon name="whatsapp-logo" class="size-5" /> Escribime por WhatsApp
      </a>
      <a
        href={`mailto:${site.email}`}
        class="btn justify-center border border-on-accent/40 text-on-accent hover:border-on-accent"
      >
        <Icon name="envelope-simple" class="size-5" /> {site.email}
      </a>
    </div>
    <p class="mt-6 text-sm text-on-accent/70">WhatsApp {site.phoneDisplay} · {site.city}</p>
  </div>
</section>
