---
// Íconos Phosphor (regular) embebidos como SVG inline.
const icons = import.meta.glob<string>(
  '/node_modules/@phosphor-icons/core/assets/regular/*.svg',
  { query: '?raw', import: 'default', eager: true },
);

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
const raw = icons[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`];
if (!raw) throw new Error(`Icono Phosphor desconocido: ${name}`);
const svg = raw.replace('<svg ', `<svg aria-hidden="true" focusable="false" class="${className}" `);
---

<Fragment set:html={svg} />
